<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- شريط الأدوات العلوي -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:background="#121212"
        android:orientation="horizontal"
        android:padding="2dp">

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_compass"
            android:tint="#888888"
            android:contentDescription="الصفحة الرئيسية" />

        <ImageButton
            android:id="@+id/btn_notifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_popup_reminder"
            android:tint="#888888"
            android:contentDescription="الإشعارات" />

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#888888"
            android:contentDescription="الرسائل" />

        <!-- زر عرض سطح المكتب الجديد بين الرسائل والمفضلة -->
        <ImageButton
            android:id="@+id/btn_desktop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#888888"
            android:contentDescription="عرض سطح المكتب" />

        <ImageButton
            android:id="@+id/btn_star_green"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/btn_star_big_on"
            android:tint="#888888"
            android:contentDescription="إضافة للمفضلة" />

        <ImageButton
            android:id="@+id/btn_star_a"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/btn_star_big_off"
            android:tint="#888888"
            android:contentDescription="عرض المفضلات" />

        <ImageButton
            android:id="@+id/btn_adblock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/btn_radio"
            android:tint="#888888"
            android:contentDescription="مانع الإعلانات" />

        <ImageButton
            android:id="@+id/btn_block_media"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_gallery"
            android:tint="#888888"
            android:contentDescription="حجب الوسائط" />

        <ImageButton
            android:id="@+id/btn_tools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="#888888"
            android:contentDescription="مرشحات المحتوى" />
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar" />

</RelativeLayout>
